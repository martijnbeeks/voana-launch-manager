# Local secrets for the kill-sync job. NEVER commit (.gitignore covers .env).
CLICKUP_API_KEY=pk_xxx
# Discord channel for kill alerts. Leave empty to fall back to the ops webhook
# (DISCORD_WEBHOOK_URL in ../voana-tools/.env) until a dedicated channel exists.
KILL_SYNC_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
